              ],
              "properties": {
                "resource_type": {
                  "type": "string"
                },
                "resource_id": {
                  "$ref": "#/components/schemas/Id"
                },
                "state": {
                  "type": "string"
                },
                "reason_code": {
                  "type": "string"
                }
              }
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
