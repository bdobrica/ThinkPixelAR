{
  "schema_version": 1,
  "name": "coding-homelab-arm64",
  "description": "Bounded homelab RC coding lane; local storage, no snapshot/fork or node-loss durability claim.",
  "isolation_class": "microvm-strong",
  "resources": {
    "cpu_millis": {
      "request": 250,
      "limit": 1000
    },
    "memory_bytes": {
      "request": 268435456,
      "limit": 536870912
    },
    "ephemeral_storage_bytes": {
      "request": 67108864,
      "limit": 134217728
    },
    "max_processes": 128,
    "gpu": {
      "count": 0,
      "classes": []
    }
  },
  "storage": {
    "workspace_bytes": 1073741824,
    "workspace_mount": "/workspace",
    "vendor_state_root": "/state",
    "access_mode": "single-writer",
    "snapshot_class": "disabled",
    "encryption_required": false
  },
  "network": {
    "profile": "none",
    "default_deny_ingress": true,
    "default_deny_egress": true,
    "deny_cloud_metadata": true,
    "deny_kubernetes_api": true,
    "dns_policy": "trusted-only"
  },
  "platform": {
    "os": "linux",
    "architectures": [
      "arm64"
    ],
    "gpu_allowed": false,
    "node_class": "kata-homelab"
  },
  "security": {
    "privileged": false,
    "run_as_non_root": true,
    "read_only_root_filesystem": true,
    "allow_privilege_escalation": false,
    "service_account_token": false,
    "host_network": false,
    "host_pid": false,
    "host_ipc": false,
    "host_paths": false,
    "runtime_sockets": false,
    "linux_capabilities_add": [],
    "seccomp_class": "runtime-default"
  },
  "lifecycle": {
    "idle_suspend_seconds": 900,
    "termination_grace_seconds": 30,
    "warm_pool_eligible": false,
    "suspend_mode": "release-and-restore"
  },
  "implementation": {
    "provider_kind": "kubernetes-agent-sandbox",
    "provider_profile_ref": "coding-homelab-arm64-v1",
    "isolation_runtime_ref": "kata-qemu-3-31",
    "storage_profile_ref": "homelab-local-v1",
    "network_policy_ref": "homelab-offline-v1"
  }
}
