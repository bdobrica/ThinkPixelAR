{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thinkpixel.dev/schemas/network-profile-v1.json",
  "title": "ThinkPixel NetworkProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "version", "mode", "config_digest", "dns", "allow"],
  "properties": {
    "schema_version": { "const": "thinkpixel.network-profile/v1" },
    "profile_id": { "$ref": "#/$defs/id" },
    "version": { "type": "integer", "minimum": 1 },
    "mode": { "enum": ["none", "thinkpixel-only", "restricted-development", "package-mirrors", "unrestricted-standalone"] },
    "config_digest": { "type": "string", "pattern": "^[A-Za-z0-9_-]{32,256}$" },
    "dns": { "enum": ["disabled", "platform-resolver", "proxy-mediated"] },
    "allow": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "rule": {
      "type": "object", "additionalProperties": false, "required": ["destination_id", "purpose", "protocol", "ports"],
      "properties": {
        "destination_id": { "$ref": "#/$defs/id" },
        "purpose": { "enum": ["thinkpixel-gateway", "repository", "artifact-store", "package-mirror", "other-approved-development"] },
        "protocol": { "enum": ["tcp", "udp"] },
        "ports": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
        "service_identity": { "type": "string", "minLength": 1, "maxLength": 253 },
        "fqdn": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^(?:\\*\\.)?[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$" },
        "cidr": { "type": "string", "minLength": 3, "maxLength": 64 }
      },
      "oneOf": [{ "required": ["service_identity"] }, { "required": ["fqdn"] }, { "required": ["cidr"] }]
    }
  }
}
